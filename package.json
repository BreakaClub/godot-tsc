{
  "name": "godot-tsc",
  "version": "7.0.0",
  "description": "Bun's TypeScript type checker and transpiler inside Godot: a GDExtension with a typed, non-blocking API for GodotJS",
  "keywords": [
    "godot",
    "godot-engine",
    "gdextension",
    "godotjs",
    "typescript",
    "type-checker",
    "transpiler",
    "bun",
    "live-coding"
  ],
  "license": "MIT",
  "homepage": "https://github.com/BreakaClub/godot-tsc#readme",
  "bugs": {
    "url": "https://github.com/BreakaClub/godot-tsc/issues"
  },
  "author": "Breaka Club",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BreakaClub/godot-tsc.git"
  },
  "bin": {
    "godot-tsc": "./bin/cli.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "host": [
        "./dist/host.d.ts"
      ],
      "lib-bundle": [
        "./node/lib-bundle.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.mjs",
      "require": "./dist/host.js"
    },
    "./lib-bundle": {
      "types": "./node/lib-bundle.d.mts",
      "import": "./node/lib-bundle.mjs"
    },
    "./package.json": "./package.json",
    "./typescript_libs.bin": "./libs/typescript_libs.bin"
  },
  "files": [
    "dist",
    "addon",
    "libs",
    "bin",
    "node",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node ./bin/cli.mjs --postinstall",
    "setup": "node ./bin/cli.mjs setup",
    "vendor": "node scripts/vendor.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:web": "node scripts/build-web.mjs",
    "stage:addon": "node scripts/stage-addon.mjs",
    "prepack": "node scripts/stage-addon.mjs --require-binaries",
    "test:types": "tsc -p tsconfig.json",
    "build": "pnpm test:types && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:rust": "node scripts/test-rust.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:verify": "node scripts/demo.mjs --verify",
    "notices": "node scripts/notices.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.3",
    "esbuild": "0.25.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
