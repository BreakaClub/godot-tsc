-    _out: *mut u8,
-    _url: c_int,
+    p: *const u8,
+    len: usize,
+    out: *mut u8,
+    url: c_int,
 ) -> usize {
-    unreachable!("nothing that parses encodes base64")
+    const STANDARD: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    const URL_SAFE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    let alphabet = if url != 0 { URL_SAFE } else { STANDARD };
+    // SAFETY: the caller passes a slice, as a pointer and a length.
+    let source = unsafe { bytes(p, len) };
+    let mut written = 0;
+    for chunk in source.chunks(3) {
+        let group = u32::from(chunk[0]) << 16
+            | u32::from(chunk.get(1).copied().unwrap_or(0)) << 8
+            | u32::from(chunk.get(2).copied().unwrap_or(0));
+        // One byte makes two characters, two bytes three, three bytes four.
+        let characters = chunk.len() + 1;
+        for index in 0..4 {
+            let byte = if index < characters {
+                alphabet[((group >> (18 - 6 * index)) & 0x3F) as usize]
+            } else if url == 0 {
+                b'='
+            } else {
+                continue;
+            };
+            // SAFETY: the caller's buffer has room for the encoded length.
+            unsafe { out.add(written).write(byte) };
+            written += 1;
+        }
+    }
+    written
