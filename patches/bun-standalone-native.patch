+    mod raw {
+        use core::ffi::c_void;
+        const FRONT: usize = 16;
+        fn layout(size: usize) -> std::alloc::Layout {
+            std::alloc::Layout::from_size_align(size + FRONT, FRONT).unwrap()
+        }
+        unsafe fn place(base: *mut u8, size: usize) -> *mut c_void {
+            if base.is_null() {
+                return core::ptr::null_mut();
+            }
+            // SAFETY: the block has `FRONT` bytes in front.
+            unsafe {
+                base.cast::<usize>().write(size);
+                base.add(FRONT).cast()
+            }
+        }
+        pub(super) unsafe fn malloc(size: usize) -> *mut c_void {
+            unsafe { place(std::alloc::alloc(layout(size)), size) }
+        }
+        pub(super) unsafe fn calloc(size: usize) -> *mut c_void {
+            unsafe { place(std::alloc::alloc_zeroed(layout(size)), size) }
+        }
+        pub(super) unsafe fn free(p: *mut c_void) {
+            if p.is_null() {
+                return;
+            }
+            unsafe {
+                let base = p.cast::<u8>().sub(FRONT);
+                std::alloc::dealloc(base, layout(base.cast::<usize>().read()));
+            }
+        }
+    }
