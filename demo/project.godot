; The godot-tsc demo: a TypeScript editor whose checking, transpiling, hover and inlay hints all come from the godot-tsc extension.
; `pnpm demo` builds and opens it; `pnpm demo:verify` runs it headless and checks every answer (scripts/demo.mjs).

config_version=5

[application]

config/name="godot-tsc demo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[GodotJS]

runtime/core/camel_case_bindings_enabled=true
